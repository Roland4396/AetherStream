# Stream Proxy
PORT=3002
DEBUG=false
TIMEOUT=600
# Legacy placeholder only: NOT an access-control mechanism in this snapshot.
# Protect remote access at a separate authenticated reverse proxy.
FIXED_API_KEY=
LOG_DIR=/app/logs
RUNTIME_FLAGS_PATH=/app/runtime-flags.json
REPLAY_CONTROL_FILE=/app/logs/claude_replay_switch.json

# OpenAI Responses API upstream
RESPONSES_API_KEY=
RESPONSES_BASE_URL=https://api.openai.com/v1
GPT_USE_RESPONSES=true
GPT_SERVICE_TIER=

# Gemini direct route
GEMINI_ENABLED=false
GEMINI_API_KEY=

# Anthropic-compatible route
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE2_API_KEY=
CLAUDE2_BASE_URL=
CLAUDE_ANTHROPIC_VERSION=2023-06-01
CLAUDE_DEFAULT_MAX_TOKENS=8192
CLAUDE_THINKING_TYPE=disabled
CLAUDE_PROMPT_CACHING_ENABLED=false
CLAUDE_PROMPT_CACHING_TYPE=ephemeral
CLAUDE_PROMPT_CACHING_TTL=
CLAUDE_PROMPT_CACHING_MODE=explicit

# Optional behavior
MAX_RAW_SSE_BYTES=0
STREAM_PROXY_VERBOSE_TRACE=false
AUTO_RESTART_SILLYTAVERN=false
